# Exemple de configuration locale pour le frontend Next.js (ISO Railway)
# Copier ce fichier en .env.local puis adapter les valeurs

############################
# Informations application
############################
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=BMS
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_DEMO_MODE=false

############################
# API & Websocket
############################
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_API_TOKEN=
NEXT_PUBLIC_WS_URL=http://localhost:3001/notifications
NEXT_PUBLIC_COMPANY_ID=

############################
# Authentification NextAuth
############################
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-local-secret-change-me

############################
# Telemetry / Analytics
############################
NEXT_TELEMETRY_DISABLED=1

############################
# Feature flags (optionnels)
############################
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
NEXT_PUBLIC_ENABLE_BANKING=true
