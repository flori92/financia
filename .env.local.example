# Fichier de variables d'environnement local (ISO Railway)
# Dupliquer en .env.local et ajuster les valeurs sensibles

############################
# Railway services (lecture)
############################
RAILWAY_DATABASE_URL=
RAILWAY_REDIS_URL=

###################################
# Base de données (aliases alignés)
###################################
DB_HOST=postgres
DB_PORT=5432
DB_USER=bms
DB_PASSWORD=bms_dev_password
DB_NAME=bms

DATABASE_HOST=${DB_HOST}
DATABASE_PORT=${DB_PORT}
DATABASE_USER=${DB_USER}
DATABASE_PASSWORD=${DB_PASSWORD}
DATABASE_NAME=${DB_NAME}
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

################################
# Redis / files d'attente Bull
################################
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

################################
# Secrets globaux & sécurité
################################
NODE_ENV=development
PORT=3001
JWT_SECRET=bms-super-secret-jwt-key-local
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=change-this-in-production-32chars
CORS_EXTRA_ORIGINS=http://localhost:3000

################################
# Services IA / Analytics (Railway)
################################
AI_ANALYTICS_SERVICE_URL=https://ia-analytics-production.up.railway.app
AI_ANALYTICS_SERVICE_PORT=8000
AI_SERVICE_URL=https://bms-ai-analytics-production.railway.app
LLM_SERVICE_URL=https://service-llm-production.up.railway.app
LLM_SERVICE_PORT=8001

################################
# Notifications / providers externes
################################
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=BMS <noreply@bms.test>
RESEND_FROM_EMAIL=no-reply@bms.test
SMS_PROVIDER=africastalking
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=BMS
AFRICASTALKING_WHATSAPP_SENDER=BMS

################################
# Mobile money (Kkiapay)
################################
MOBILE_MONEY_PROVIDER=kkiapay
MOBILE_MONEY_PUBLIC_KEY=
MOBILE_MONEY_PRIVATE_KEY=
MOBILE_MONEY_SECRET_KEY=
MOBILE_MONEY_WEBHOOK_SECRET=

################################
# API externes / OCR
################################
GOOGLE_VISION_API_KEY=
OCR_SPACE_API_KEY=

################################
# Stockage objet (Cloudflare R2 par défaut)
################################
STORAGE_PROVIDER=r2 # valeurs possibles: local|minio|s3|r2

# Configuration Cloudflare R2 (production & local ISO)
MINIO_ENDPOINT=https://42fc982266a2c31b942593b18097e4b3.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=42fc982266a2c31b942593b18097e4b3
MINIO_SECRET_KEY=YxQBDnGnKO6pP0KGAjhCQGP6qDampLF2r-swl1q2
MINIO_BUCKET=bms
MINIO_USE_SSL=true
MINIO_REGION=auto
MINIO_FORCE_PATH_STYLE=true

# Fallback MinIO local (désactiver R2 si besoin de tests hors-ligne)
