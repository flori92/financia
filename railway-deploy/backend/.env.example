# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=bms_erp

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d

# API Keys (Budget Insight)
BUDGET_INSIGHT_CLIENT_ID=your_budget_insight_client_id
BUDGET_INSIGHT_CLIENT_SECRET=your_budget_insight_client_secret
BUDGET_INSIGHT_REDIRECT_URI=http://localhost:3000/auth/budget-insight/callback

# Google Cloud Vision
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
GOOGLE_CLOUD_PROJECT=bms-erp-prod
GOOGLE_VISION_API_KEY=AIzaSyClé_API_Google_Vision_Partagée_Hier

# Environment
NODE_ENV=development
PORT=3001
