# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=bms_erp

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Railway Redis (si utilisé sur Railway)
# REDIS_URL=redis://default:password@host:port
# REDIS_HOST=your-redis-host.railway.app
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d

# API Keys
BUDGET_INSIGHT_CLIENT_ID=
BUDGET_INSIGHT_CLIENT_SECRET=

# Environment
NODE_ENV=development
PORT=3001

# Configuration des notifications
# Email Provider (console, smtp, sendgrid, resend)
EMAIL_PROVIDER=console

# Configuration SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-app
SMTP_FROM="BMS" <noreply@bms.com>

# Configuration SendGrid
SENDGRID_API_KEY=votre-cle-api-sendgrid
SENDGRID_FROM=noreply@bms.com

# Configuration Resend (RECOMMANDÉ - 3000 emails/mois gratuit)
RESEND_API_KEY=re_votre_cle_api
RESEND_FROM=BMS <noreply@votre-domaine.com>

# SMS Provider (console, twilio, africastalking)
SMS_PROVIDER=console

# Configuration Twilio SMS
TWILIO_ACCOUNT_SID=votre-account-sid
TWILIO_AUTH_TOKEN=votre-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Configuration Africa's Talking (RECOMMANDÉ pour Afrique)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=votre-api-key
AFRICASTALKING_SENDER_ID=BMS

# WhatsApp Provider (console, twilio, meta)
WHATSAPP_PROVIDER=console

# Configuration Twilio WhatsApp
TWILIO_WHATSAPP_NUMBER=+14155238886

# Configuration Meta WhatsApp Business
META_ACCESS_TOKEN=votre-access-token-meta
META_PHONE_NUMBER_ID=votre-phone-number-id

# URL de l'application frontend
FRONTEND_URL=https://app.bms.com
