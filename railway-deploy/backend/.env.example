# ====================================
# BMS Backend - Railway Production Configuration
# ====================================

# Database - Railway PostgreSQL
DATABASE_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway
DATABASE_PUBLIC_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway

# Redis - Railway Redis
REDIS_URL=redis://default:PASSWORD@redis.railway.internal:6379

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d

# Application Configuration
NODE_ENV=production
PORT=3001
CORS_EXTRA_ORIGINS=https://bms-frontend-production.up.railway.app,https://bms-production-d9e9.up.railway.app

# AI Services URLs
AI_ANALYTICS_SERVICE_URL=https://bms-ai-analytics-production.up.railway.app
LLM_SERVICE_URL=https://bms-llm-service-production.up.railway.app

# Google Cloud Services
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
GOOGLE_CLOUD_PROJECT=bms-erp-prod
GOOGLE_VISION_API_KEY=your-google-vision-api-key
GOOGLE_DOCUMENT_AI_API_KEY=your-google-document-ai-api-key
GOOGLE_DOCUMENT_AI_PROJECT_ID=your-project-id
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=your-processor-id

# Email Service (Resend)
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=noreply@your-domain.com

# SMS Service (Africa's Talking)
AFRICAS_TALKING_USERNAME=your-app-name
AFRICAS_TALKING_API_KEY=your-africas-talking-api-key

# Mobile Money (Kkiapay)
KKIAPAY_PUBLIC_KEY=your-public-key
KKIAPAY_PRIVATE_KEY=your-private-key
KKIAPAY_SECRET=your-secret
MOBILE_MONEY_SANDBOX=false

# OCR Service
OCR_SPACE_API_KEY=your-ocr-space-api-key

# Cloud Storage (Cloudflare R2)
STORAGE_PROVIDER=r2
MINIO_ENDPOINT=your-account.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=your-bucket-name
MINIO_REGION=auto
MINIO_USE_SSL=true
MINIO_FORCE_PATH_STYLE=false

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# Frappe Integration
FRAPPE_URL=https://your-frappe-instance.com
FRAPPE_API_KEY=your-frappe-api-key
FRAPPE_API_SECRET=your-frappe-api-secret

# Legacy SMTP Configuration (Alternative)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FRONTEND_URL=https://bms-frontend-production.up.railway.app
WEB_APP_URL=https://bms-frontend-production.up.railway.app
