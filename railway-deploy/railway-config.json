{
  "name": "bms-erp",
  "services": {
    "backend": {
      "source": {
        "project": "financia",
        "root": "backend"
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "npm start",
        "healthcheckPath": "/health",
        "port": 8080
      }
    },
    "frontend": {
      "source": {
        "project": "financia", 
        "root": "frontend"
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "npm start",
        "port": 3000
      }
    }
  },
  "environment": {
    "NODE_ENV": "production",
    "DYNAMIC_MODE": "true"
  }
}
