# API Gateway Configuration
NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=bms
DB_PASSWORD=bms_dev_password
DB_NAME=bms

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=change-this-in-production-32chars

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=xxxxx
PAYPAL_CLIENT_SECRET=xxxxx
PAYPAL_WEBHOOK_ID=xxxxx

# Open Banking
OPEN_BANKING_URL=https://api.openbanking.com
OPEN_BANKING_API_KEY=xxxxx

# Bridge API
BRIDGE_API_URL=https://api.bridgeapi.io/v2
BRIDGE_CLIENT_ID=xxxxx
BRIDGE_CLIENT_SECRET=xxxxx

# Budget Insight
BUDGET_INSIGHT_URL=https://api.biapi.pro/2.0
BUDGET_INSIGHT_CLIENT_ID=xxxxx
BUDGET_INSIGHT_CLIENT_SECRET=xxxxx

# Flutterwave (À obtenir sur https://dashboard.flutterwave.com)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxx
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TEST-xxxxx

# WhatsApp Business API (Optionnel)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# Twilio SMS (Optionnel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@bms.com

# Frappe/ERPNext Integration (Optionnel)
FRAPPE_BASE_URL=http://localhost:8000
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
